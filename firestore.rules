rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // COURSES COLLECTION RULES
    // ===============================================================
    // - Public can read published courses.
    // - Writing, modifying, or deleting courses requires administrative authentication.
    match /courses/{courseId} {
      allow read: if resource.data.published == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ===============================================================
    // INQUIRIES COLLECTION RULES
    // ===============================================================
    // - Anyone can submit an inquiry with valid fields.
    // - Public users CANNOT read, list, update, or delete inquiries to protect privacy.
    // - Only authenticated administrators can inspect or manage inquiries.
    match /inquiries/{inquiryId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;

      // Validate submission schema when public submits an inquiry
      allow create: if request.resource.data.keys().hasAll([
        'fullName', 'email', 'phone', 'courseInterest', 'subject', 'message', 'status', 'createdAt'
      ])
      && request.resource.data.fullName is string
      && request.resource.data.fullName.size() >= 2
      && request.resource.data.fullName.size() <= 100
      && request.resource.data.email is string
      && request.resource.data.email.matches('^.+@.+\\..+$')
      && request.resource.data.phone is string
      && request.resource.data.phone.size() >= 5
      && request.resource.data.phone.size() <= 30
      && request.resource.data.subject is string
      && request.resource.data.subject.size() >= 3
      && request.resource.data.subject.size() <= 150
      && request.resource.data.message is string
      && request.resource.data.message.size() >= 10
      && request.resource.data.message.size() <= 5000
      && request.resource.data.status == 'new'
      && request.resource.data.createdAt == request.time;
    }

    // Default catch-all rule: Deny all other unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
